Algoritmo Matrices
	Definir dim,i,j como enteros
	Escribir "Dime el tamaño de la matriz"
	Leer dim
	Para i<-1 Hasta dim  Hacer
		Para j<-1 Hasta dim  Hacer
			//Aqui dibujo la tabla/matriz
			Si i=j Entonces
				//Significa que estoy en la diagonal
				Escribir sin saltar "1"
			SiNo
				//Si la fila no es igual que la columna, no estoy en la diagonal.
				Escribir sin saltar "0"
			Fin Si
		Fin Para
		Escribir ""
	Fin Para
	
FinAlgoritmo
