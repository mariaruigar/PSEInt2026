Algoritmo ContadorHaSTA100
	Definir contador,j,i Como Entero
	i<-1
	contador<-1
	//Bucle que me cuenta las filas
	Mientras i<=10 Hacer
		//Bucle que cuenta las columnas
		j<-1
		Mientras j<=10 Hacer
			Escribir Sin Saltar contador, " "
			contador<-contador+1
			j<-j+1
		Fin Mientras
		Escribir ""
		i<-i+1
	Fin Mientras
	
	
FinAlgoritmo
